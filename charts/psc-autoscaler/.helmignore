# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Karpenter automation CRDs are not released yet. On dev, apply them manually:
#   kubectl apply -f helm/crds/clusternodegroupautomationconfig.yaml \
#     -f helm/crds/nodegroupautomationconfig.yaml -f helm/crds/karpenterautomationstatus.yaml
crds/clusternodegroupautomationconfig.yaml
crds/nodegroupautomationconfig.yaml
crds/karpenterautomationstatus.yaml
# NodeAutomationStatus CRD is not released yet. On dev, apply it manually:
#   kubectl apply -f helm/crds/nodeautomationstatus.yaml
crds/nodeautomationstatus.yaml
