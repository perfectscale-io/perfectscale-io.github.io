# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# NodeGroupAutomationStatus CRD is not released yet. On dev, apply it manually:
#   kubectl apply -f helm/crds/nodegroupautomationstatus.yaml
crds/nodegroupautomationstatus.yaml
